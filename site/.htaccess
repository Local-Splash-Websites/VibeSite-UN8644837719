# Static copy of a Duda site. HTTPS and www are handled by the proxy in front of this
# container, so there is no https/www redirect here.

Options -Indexes -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Duda's telemetry and the CDN's analytics beacon: accept and drop.
RewriteRule ^_d/rtc\.multiscreensite\.com/ - [R=204,L]
RewriteRule ^cdn-cgi/rum - [R=204,L]
RewriteRule ^_dm/s/rt/actions/(logs|lcp-report) - [R=204,L]

# The copied Duda forms post to Duda's form endpoint; handle them locally.
RewriteRule ^_dm/s/rt/actions/form/ lead-webhook.php [L]

# Assets requested with a query string: serve the response saved for that exact query.
RewriteCond %{QUERY_STRING} .
RewriteRule ^_d/ qrouter.php [L]

# Image sizes Duda's runtime picks at run time that were never requested on the live site:
# serve the closest copied size.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^_d/irp\.cdn-website\.com/.+\.(png|jpe?g|webp|gif)$ img-fallback.php [L,NC]

# Clean URLs: /about.html -> /about, /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Duda serves different HTML to tablets and phones (by User-Agent); _t/ and _m/ hold those copies,
# and _a/ (only where Duda's Android-phone HTML differs from iPhone's) the Android phone copy.
RewriteCond %{HTTP_USER_AGENT} "iPad|Tablet|Kindle|Silk/|PlayBook|Nexus (7|9|10)|SM-T|SM-X|Android(?!.*Mobile)" [NC]
RewriteRule ^ - [E=DEV:_t]
RewriteCond %{ENV:DEV} ^$
RewriteCond %{HTTP_USER_AGENT} "Android.*Mobile" [NC]
RewriteCond %{DOCUMENT_ROOT}/_a -d
RewriteRule ^ - [E=DEV:_a]
RewriteCond %{ENV:DEV} ^$
RewriteCond %{HTTP_USER_AGENT} "iPhone|iPod|Android.*Mobile|Windows Phone|IEMobile|BlackBerry|BB10|Opera Mini|webOS" [NC]
RewriteRule ^ - [E=DEV:_m]
RewriteCond %{ENV:DEV} ^_[mta]$
RewriteCond %{DOCUMENT_ROOT}/%{ENV:DEV}/index.html -f
RewriteRule ^$ %{ENV:DEV}/index.html [L]
RewriteCond %{ENV:DEV} ^_[mta]$
RewriteCond %{DOCUMENT_ROOT}/%{ENV:DEV}/$1.html -f
RewriteRule ^(.+?)/?$ %{ENV:DEV}/$1.html [L]

# Serve /about from about.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Same as Duda: /home goes to the home page
RewriteRule ^home/?$ / [R=301,L]

<FilesMatch "^css2$">
  ForceType text/css
</FilesMatch>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
    # the HTML differs by device, so caches must key on User-Agent
    Header append Vary User-Agent
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType video/mp4 .mp4
AddType text/javascript .js
