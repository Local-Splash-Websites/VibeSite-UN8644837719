# Set these in Deploy (site Environment tab) or copy to .env one level above the web root.

# Leads API that lead-webhook.php forwards form submissions to
LEADS_API_URL=
# Bearer token for the leads API, if it requires one
LEADS_API_KEY=
# site_name sent with every lead: the Duda site ID of the original site
LEADS_SITE_NAME=bc06e187
