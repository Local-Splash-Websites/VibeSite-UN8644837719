# Set these in Deploy (site Environment tab) or copy to .env one level above the web root.

# Shared LocalSplash lead service that lead-webhook.php forwards form submissions to (POST /v1/lead).
# Deploy sets it as a global variable. The service finds this site in Deploy's site registry from the
# visitor's host and sends the lead on under the registry's RelevantAds site_name (8644837719).
LEADS_SERVICE_URL=http://website-lead-submit:8080
